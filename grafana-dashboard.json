{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "Photo Service",
  "uid": "photo-service",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Загрузки",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 40
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{method=\"POST\", path=\"/api/v1/photos/\"}[30m]))",
          "legendFormat": "загружено",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Время анализа",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "rate(photo_analysis_duration_seconds_sum[30m]) / rate(photo_analysis_duration_seconds_count[30m])",
          "legendFormat": "среднее",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Упавшие фото",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(photo_analysis_completed_total{status=\"failed\"}[30m]))",
          "legendFormat": "упало",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Очередь",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "fillOpacity": 30
          }
        }
      },
      "targets": [
        {
          "expr": "messages_in_queue",
          "legendFormat": "pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Успех анализа",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "red", "value": 80 },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 100 }
            ]
          },
          "mappings": [
            {
              "options": {
                "no data": { "text": "N/A" }
              },
              "type": "special"
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(photo_analysis_completed_total{status=\"done\"}) / (sum(photo_analysis_completed_total{status=\"done\"}) + sum(photo_analysis_completed_total{status=\"failed\"})) * 100",
          "legendFormat": "успех",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Коды ответов",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "stacking": { "mode": "normal" },
            "lineInterpolation": "linear",
            "showPoints": "never",
            "fillOpacity": 60
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (status_code) (increase(http_requests_total[30m]))",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Активность по ручкам",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "expr": "topk(5, sum by (path) (increase(http_requests_total{path!=\"/metrics\"}[30m])))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Загрузка очереди",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "fillOpacity": 20
          }
        }
      },
      "targets": [
        {
          "expr": "messages_in_queue",
          "legendFormat": "pending",
          "refId": "A"
        },
        {
          "expr": "consumer_lag",
          "legendFormat": "всего ждут",
          "refId": "B"
        }
      ]
    }
  ]
}
